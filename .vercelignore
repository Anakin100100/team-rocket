# Local env files must never ship in deployments: Vercel project env vars are
# the source of truth (bun env:vercel:*), and frameworks like Next.js would
# otherwise load these localhost values at runtime.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.schema
local.db
local.db-*
.alchemy/
# Local build output must not ship either: Vercel's Hono builder prefers an
# existing apps/server/dist/index.mjs over compiling src, so a stale local (or
# turbo-cache-restored) bundle would replace the server code.
**/dist/
**/.turbo/
