# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# Public URLs: they appear in OAuth/MCP discovery documents, CORS headers and
# email links, so varlock's leak scanner must not treat them as secrets.
# @internal @required=false @sensitive=false
VERCEL_URL=

# @internal @required=false @sensitive=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true) @sensitive=false
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url @sensitive=false
BETTER_AUTH_URL=if($VERCEL_ORIGIN, "${VERCEL_ORIGIN}/api/auth", undefined)

# @type=url @sensitive=false
CORS_ORIGIN=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# Sending-only Resend key for auth emails (verification, password reset, invitations)
# @type=string(startsWith="re_")
RESEND_API_KEY=

# Sender for auth emails; the domain must be verified in Resend
# @sensitive=false @type=string(minLength=3)
EMAIL_FROM="Rocket <noreply@build-the-arsenal-team-rocket.com>"

# Owners and admins of the organization with this slug are app admins (they see
# the feedback panel).
# @sensitive=false @type=string(minLength=1)
ADMIN_ORGANIZATION_SLUG=team-rocket

# --- Market agents (packages/market) ---
# Anthropic API key for the buyer and supplier agents. Without it both sides
# run as deterministic mocks.
# @required=false @type=string(startsWith="sk-ant-")
ANTHROPIC_API_KEY=

# @sensitive=false @type=string(minLength=1)
MARKET_MODEL=claude-opus-5-5

# @sensitive=false @type=enum(low, medium, high, xhigh, max)
MARKET_EFFORT=high

# Replace the supplier model calls with code (rehearsal / stage fallback).
# @sensitive=false @type=boolean
MOCK_SUPPLIERS=false

# Replace the buyer agent with a scripted buyer (no API key needed).
# @sensitive=false @type=boolean
MOCK_BUYER=false

# Wall-clock budget of one round (POST /api/rfq/:id/run); keep below the
# function's maxDuration.
# @sensitive=false @type=number(min=10000, max=290000)
ROUND_BUDGET_MS=240000
