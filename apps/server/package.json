{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "org:create": "varlock run -- tsx scripts/create-organization.ts",
    "agents:seed": "varlock run -- tsx scripts/seed-agents.ts",
    "market:races": "varlock run -- tsx scripts/smoke-races.ts",
    "market:traders": "varlock run -- tsx scripts/smoke-traders.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@rocket/api": "workspace:*",
    "@rocket/auth": "workspace:*",
    "@rocket/db": "workspace:*",
    "@rocket/market": "workspace:*",
    "@vercel/functions": "^3.10.5",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "evlog": "^2.33.1",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rocket/config": "workspace:*",
    "@types/node": "^26.4.1",
    "tsdown": "^0.23.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
